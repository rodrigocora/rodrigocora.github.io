<p>Check and recompile invalid objects</p>

<div class="highlighter-rouge"><div class="highlight"><pre class="highlight"><code>SET PAGESIZE 300
SET LINESIZE 300

SELECT
    'ALTER ' || 
    CASE
        WHEN OBJECT_TYPE LIKE '%BODY' 
            THEN TRIM(REGEXP_SUBSTR(OBJECT_TYPE, '.*\s'))
        WHEN OBJECT_TYPE = 'SYNONYM' AND OWNER = 'PUBLIC' 
            THEN 'PUBLIC ' || OBJECT_TYPE
    ELSE
        OBJECT_TYPE
    END   
     || ' ' ||
    CASE 
        WHEN OWNER != 'PUBLIC' THEN '"' || OWNER || '".'
    ELSE
        ''
    END
    || '"' || OBJECT_NAME || '"' || 
    CASE
        WHEN OBJECT_TYPE LIKE '%BODY' THEN ' COMPILE BODY'
    ELSE
        ' COMPILE'
    END || ';'
FROM
	DBA_OBJECTS
WHERE
	STATUS != 'VALID'
ORDER BY OBJECT_TYPE;
</code></pre></div></div>

