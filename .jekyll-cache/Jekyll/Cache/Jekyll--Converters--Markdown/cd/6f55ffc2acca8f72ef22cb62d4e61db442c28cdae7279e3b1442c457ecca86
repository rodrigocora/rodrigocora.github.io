I"<h4 id="find-dblinks-being-used-in-materialized-views">Find dblinks being used in materialized views</h4>

<div class="highlighter-rouge"><div class="highlight"><pre class="highlight"><code>DECLARE
    TEXT_LOB CLOB;
BEGIN
    FOR X IN (
        SELECT
            OWNER,
            MVIEW_NAME,
            QUERY
        FROM
            DBA_MVIEWS
    ) LOOP
        TEXT_LOB := X.QUERY;
        TEXT_LOB := REPLACE(REGEXP_SUBSTR(TEXT_LOB, '@(")?\w+(\.\w+\.\w+(")?)?'), '"');
        IF TEXT_LOB IS NOT NULL THEN
            DBMS_OUTPUT.PUT_LINE(X.OWNER
                                 || '.'
                                 || X.MVIEW_NAME
                                 || ' - '
                                 || TEXT_LOB);
        END IF;

    END LOOP;
END;
/
</code></pre></div></div>

<h4 id="find-dblinks-being-used-in-others-objects">Find dblinks being used in others objects</h4>

<div class="highlighter-rouge"><div class="highlight"><pre class="highlight"><code>SET LINES 200
SET PAGES 0
COL OWNER FORMAT A20
COL NAME FORMAT A40
COL OBJECT_DBLINK FORMAT A50

SELECT DISTINCT
    OWNER,
    NAME,
    REGEXP_SUBSTR(TEXT, '\w+@\w+(\.TIMWE\.COM)?') AS "OBJECT_DBLINK"
FROM
    DBA_SOURCE
WHERE
    TEXT LIKE '%@%'
ORDER BY
    "OBJECT_DBLINK";
</code></pre></div></div>
