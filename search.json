---
layout: null
sitemap: false
---
[
{%- for post in site.posts -%}
  {
    "title": {{ post.title | strip_html | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "description": {{ post.description | jsonify }},
    "body": {{ post.content | strip_html | jsonify }}
  }{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
